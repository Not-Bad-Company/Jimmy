# Server Configuration
HOST=127.0.0.1
PORT=3000
RUST_LOG=info,rocky=debug

# LLM Configuration
# Modes: "local" (llama.cpp/ollama), "mistral" (Mistral La Plateforme API), or "mock"
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.9
LLM_MAX_TOKENS=120
LLM_REASONING=false

# To use Mistral's API instead (e.g. for Raspberry Pi deployment, where a
# local 7B model isn't feasible), set:
#   LLM_PROVIDER=mistral
#   LLM_BASE_URL=https://api.mistral.ai/v1
#   LLM_MODEL=mistral-small-latest
#   MISTRAL_KEY=<your key from https://console.mistral.ai>
# MISTRAL_KEY=

# Session memory: after this many minutes of no new messages, the next
# message starts a fresh conversation instead of appending to stale context.
SESSION_IDLE_TIMEOUT_MINUTES=20

# STT Configuration
# Modes: "local" (faster-whisper service), "mistral" (Voxtral API), or "mock"
STT_PROVIDER=local
STT_SERVICE_URL=http://127.0.0.1:8001/transcribe
STT_MODEL=base.en
AUDIO_INPUT_DEVICE=default

# To use Mistral's Voxtral transcription API instead:
#   STT_PROVIDER=mistral
#   STT_SERVICE_URL=https://api.mistral.ai/v1
#   STT_MODEL=voxtral-mini-latest
# ($0.003/minute batch — needs MISTRAL_KEY set above)

# TTS Configuration
# Modes: "local" (kokoro service) or "mock"
TTS_PROVIDER=local
TTS_SERVICE_URL=http://127.0.0.1:8001/synthesize
TTS_MODEL=kokoro-v0_19
TTS_VOICE=bm_daniel
AUDIO_OUTPUT_DEVICE=default
