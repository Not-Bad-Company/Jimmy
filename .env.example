# Server Configuration
HOST=127.0.0.1
PORT=3000
RUST_LOG=info,rocky=debug

# LLM Configuration
# Modes: "local" (llama.cpp/ollama) or "mock"
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=120
LLM_REASONING=false

# STT Configuration
# Modes: "local" (faster-whisper service) or "mock"
STT_PROVIDER=local
STT_SERVICE_URL=http://127.0.0.1:8001/transcribe
STT_MODEL=base.en
AUDIO_INPUT_DEVICE=default

# TTS Configuration
# Modes: "local" (kokoro service) or "mock"
TTS_PROVIDER=local
TTS_SERVICE_URL=http://127.0.0.1:8001/synthesize
TTS_MODEL=kokoro-v0_19
TTS_VOICE=bm_george
AUDIO_OUTPUT_DEVICE=default
